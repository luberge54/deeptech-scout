# Python
__pycache__/
*.py[cod]
.venv/

# Secrets — never commit
.env

# Collected data and generated reports. Note the trailing /* on data/raw:
# git cannot re-include a file whose parent directory is itself excluded, so
# excluding the contents rather than the directory is what makes the exception
# below possible.
data/raw/*
data/output/

# Exception: the discarded 12-search ANYbotics run. It is the primary evidence
# that a tight search budget manufactures absence (docs/00-scoping.md section 6),
# so it is version-controlled while every other collected file is not.
!data/raw/anybotics.first-run-12-searches.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
